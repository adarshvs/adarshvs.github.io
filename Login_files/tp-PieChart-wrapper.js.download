var PieChart={initializeWidget:function(t,a,e){t.innerHTML="<div id='"+this.getCustomContainerID(a)+"' class='visualizationOverdue'></div>",this.crossCheckVariables(a)&&this.drawGraph(this.getData(a),this.getCustomContainerID(a))},modelChange:function(t,a,e){"data"===a&&this.crossCheckVariables(t)&&this.drawGraph(this.getData(t),this.getCustomContainerID(t))},crossCheckVariables:function(t){return""!==this.getDataAsString(t)&&""!==this.getCustomContainerID(t)},getDataAsString:function(t){return t.data},getData:function(t){return JSON.parse(t.data||"{}")},getCustomContainerID:function(t){return t.customContainerID},drawGraph:function(t,a){var e=t.chartProperties;google.charts.load("current",{packages:["corechart"]}),google.setOnLoadCallback((function(){var i=document.getElementById(a),n=new google.visualization.PieChart(i),r=new google.visualization.arrayToDataTable(t.data);n.draw(r,e)}))}};