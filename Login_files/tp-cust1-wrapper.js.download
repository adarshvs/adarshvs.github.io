cust1={initializeWidget:function(e,t){e.innerHTML=`\n        <div style="postion: absolute; width: 100%; height: 100%; font-family: sans-serif;">\n            <canvas id="canvas_${t.id}" class="cust1__canvas" height="300" width="300" style="width: 100%; font-family: 'SourceSansPro-Regular'; position:absolute; top:0px">\n            </canvas>\n            <div style="position:absolute; top: calc(50% - 25px); width:100%; text-align: center; color: #424242; font-family: 'SourceSansPro-Regular'; font-size: 30px; font-weight: 600;">\n                <span id="cust1_label_${t.id}" style="font-family: 'SourceSansPro-Regular';top: -7px;"></span>\n                <span style="display: inline-block; position: relative; font-family: 'SourceSansPro-Regular'; font-size: 17px; top: -7px; margin-left: -5px;">%</span>\n            </div>\n            <div style="position:absolute; top: calc(50% + 10px); width:100%;text-align: center; color: #727272;font-family: 'SourceSansPro-Regular'; font-size: 11px;">Complete</div>\n        <div>\n        `,cust1.modelChange(t,"percentage",t.percentage)},modelChange:function(e,t,n){if("percentage"==t){let t=parseInt(n);var a=setInterval((function(){if(null==document.getElementById(`cust1_label_${e.id}`))console.log("CUSTOM WIDGET NULL");else{document.querySelector(`#cust1_label_${e.id}`).innerHTML=parseInt(n);let l=document.querySelector(`#canvas_${e.id}`),i=l.getContext("2d");i.beginPath(),i.clearRect(0,0,l.width,l.height),console.log("called"),i.arc(150,150,130,0,2*Math.PI),i.lineWidth=20,i.lineCap="round",i.strokeStyle="#e3e3e3",i.stroke(),i.closePath();var o="#293276ff";100==t&&(o="#2A9E05ff"),t>0&&t<=100&&(i.beginPath(),i.strokeStyle=o,i.arc(150,150,130,-Math.PI/2,2*Math.PI/100*t-Math.PI/2),i.stroke(),i.closePath()),clearInterval(a)}}),500)}}};