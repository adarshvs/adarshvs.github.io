var SCFBarChart={barChart:"",initializeWidget:function(a,t,e){a.innerHTML=`<div id='${t.id}Legend' style='margin-left: 55%; width: 30%;' class="customTradeChartLegend"></div>\n        <div style="width: 100%; height: 300px; margin: 0 auto;">\n            <canvas id="${t.id}" style="width: 100%; height: 100%;"></canvas>\n        </div>\n        </div>`,this.modelChange(t)},modelChange:function(a,t,e){if("chartData"===t)this.updateBarChart(a);else this.addBarChart(a)},addBarChart:function(a){const{chartData:t,chartProperties:e,plugins:r}=a,n=document.getElementById(a.id).getContext("2d");this.barChart=new Chart(n,{type:"bar",data:{labels:t.labels,datasets:t.datasets},options:e,plugins:r||[]}),this.generateBarChartLegend(a)},updateBarChart:function(a){const{chartData:{labels:t,datasets:e}}=a;this.barChart.data.labels=t,this.barChart.data.datasets=e,this.barChart.update(),this.generateBarChartLegend(a)},generateBarChartLegend:function(a){const t=document.getElementById(`${a.id}Legend`);if(!t||!a.chartData)return;let e="<ul>";(a.chartData.datasets||[]).forEach(((a,t)=>{const{label:r,backgroundColor:n}=a;e+=`<li><span style="background-color: ${n};"></span><p>${r}</p></li>`})),e+="</ul>",t.innerHTML=e}};