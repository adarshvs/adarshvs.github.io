var TLDonutChart={doughnutChart:"",initializeWidget:function(t,a,e){t.innerHTML=`<div style="width: 216px; height: 216px; margin: 0 auto;">\n            <canvas id="${a.id}" style="width: 100%; height: 100%;"></canvas>\n        </div>\n        <div id='${a.id}Legend' style="display: flex; margin-left: 30px; margin-top: 20px;" class="customTradeChartLegend">\n        </div>`,this.modelChange(a)},modelChange:function(t,a,e){if("chartData"===a)this.updateDoughnutChart(t);else this.addDoughnutChart(t)},addDoughnutChart:function(t){const a=t.chartData,e=document.getElementById(t.id).getContext("2d"),n=a.map((t=>t.label)),d=a.map((t=>Number(t.value||0))),o=a.map((t=>t.color));this.doughnutChart=new Chart(e,{type:"doughnut",data:{labels:n,datasets:[{data:d,backgroundColor:o,borderWidth:0}]},options:t.chartProperties,plugins:t.plugins||[]}),this.generateDoughnutLegend(t)},updateDoughnutChart:function(t){const a=t.chartData,e=a.map((t=>t.label)),n=a.map((t=>Number(t.value||0))),d=a.map((t=>t.color));this.doughnutChart.data.labels=e,this.doughnutChart.data.datasets=[{data:n,backgroundColor:d,borderWidth:0}],this.doughnutChart.update(),this.generateDoughnutLegend(t)},generateDoughnutLegend:function(t){const a=document.getElementById(`${t.id}Legend`);if(!a)return;let e="<ul>";(t.chartData||[]).forEach((t=>{const{label:a,value:n,color:d}=t;e+=`<li><span style="background-color: ${d};"></span><p>${a} - ${n}</p></li>`})),e+="</ul>",a.innerHTML=e}};