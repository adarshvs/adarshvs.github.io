cust3={initializeWidget:function(e,t){e.innerHTML=`\n        <style>\n            perctangeCust3::after{\n                content: "%";\n                position: absolute;\n                top: 0px;\n                left: 100%;\n                font-size: 17px;\n            }\n        </style>\n        <div style="postion: absolute; width: 100%; height: 100%; font-family: sans-serif;">\n            <canvas id="canvas2_${t.id}" height="300" width="300" style="width: 100%; font-family: 'SourceSansPro-Regular'; position:absolute; top:0px">\n            </canvas>\n            <div class="perctangeCust3" style="position:absolute; top: calc(50% - 30px); width:100%; text-align: center;font-family: 'SourceSansPro-Regular';  color: #424242; font-size: 30px; font-weight: 600;">\n                <span id="cust2_label_${t.id}" style="font-family: 'SourceSansPro-Regular';"></span>\n                <span style="display: inline-block; position: relative; font-size: 17px;font-family: 'SourceSansPro-Regular';  top: -7px; margin-left: -3px;">%</span>\n            </div>\n            <div style="position:absolute; top: 55%; width:100%;text-align: center;font-family: 'SourceSansPro-Regular'; color: #727272; font-size: 11px;">Complete</div>\n            <div style="position:absolute; left:0px; top: 75%; font-size:13px; font-family: 'SourceSansPro-Regular';color: #727272;">0%</div>\n            <div style="position:absolute; right:0px; top: 75%; font-size:13px; font-family: 'SourceSansPro-Regular';color: #727272;">100%</div>\n        <div>\n        `,cust3.modelChange(t,"percentage",t.percentage)},modelChange:function(e,t,n){let o=e=>Math.PI/180*e;if("percentage"==t){parseInt(n);var i=setInterval((function(){if(null==document.getElementById(`cust2_label_${e.id}`))console.log("CUSTOM WIDGET NULL");else{document.querySelector(`#cust2_label_${e.id}`).innerHTML=parseInt(n);let a=document.querySelector(`#canvas2_${e.id}`),l=a.getContext("2d"),s=parseInt(n);l.beginPath(),l.clearRect(0,0,a.width,a.height),l.arc(150,150,130,o(-205),o(25)),l.lineWidth=20,l.lineCap="round",l.strokeStyle="#e3e3e3",l.stroke(),l.closePath();var t="#293276ff";100==s&&(t="#2A9E05ff"),s>0&&s<=100&&(l.beginPath(),l.strokeStyle=t,l.arc(150,150,130,o(-205),o(2.3*s-180-25)),l.stroke(),l.closePath()),clearInterval(i)}}),500)}}};