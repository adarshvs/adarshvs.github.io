var TFBarChart={charts:{},initializeWidget:function(t,a,e){t.innerHTML=`<div style="width: 100%; height: 100%; margin: 0 auto;">\n            <canvas id="${a.id}" style="width: 100%; height: 100%;"></canvas>\n        </div>`,this.modelChange(a)},modelChange:function(t,a,e){if("chartData"===a)this.updateBarChart(t);else this.addBarChart(t)},addBarChart:function(t){const{chartData:a,chartProperties:e,plugins:n,id:s}=t,i=document.getElementById(s).getContext("2d");this.charts[s]=new Chart(i,{type:"bar",data:{labels:a.labels,datasets:a.datasets},options:e,plugins:n||[]})},updateBarChart:function(t){const a=this.charts[t.id];if(a){const{chartData:{labels:e,datasets:n}}=t;a.data.labels=e,a.data.datasets=n,a.update()}else kony.ui.Alert({message:`Chart with ID ${t.id} not found.`,alertType:constants.ALERT_TYPE_ERROR},{contentAlignment:constants.ALERT_CONTENT_ALIGN_CENTER})}};